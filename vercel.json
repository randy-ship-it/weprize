{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/spamfun/prank",
      "destination": "/spamfun/prank.html"
    },
    {
      "source": "/spamfun/nocall",
      "destination": "/spamfun/nocall.html"
    },
    {
      "source": "/spamfun",
      "destination": "/spamfun/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{server/**,src/data/contests.json,data/**}"
    }
  },
  "redirects": [
    {
      "source": "/funspamcover",
      "destination": "/spamfun",
      "permanent": true
    },
    {
      "source": "/funspamcover/:path*",
      "destination": "/spamfun",
      "permanent": true
    }
  ]
}
