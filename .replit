# WePrize Autoscale — Node Express serves SPA (dist/) + API
# Build with vite; run Express on 0.0.0.0:5000 (Stripe webhook, orders, identity, assist queue)
run = "npm run start"
modules = ["nodejs-20"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80
